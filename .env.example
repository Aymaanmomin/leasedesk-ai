# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Supabase project (Settings → API). The anon key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used in auth email links, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Server-only secrets. Not used yet in Milestone 1. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
